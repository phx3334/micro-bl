APP_JWT_ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me
APP_JWT_REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me

# -----------------------------
# Database（本地 MySQL：需先建 phx 用户并授权三库）
# 各服务用 APP_DATABASE_DBNAME 指定自己的库：
#   user -> feed_user / video、worker -> feed_video / interaction -> feed_interaction
# -----------------------------
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=3306
APP_DATABASE_USER=phx
APP_DATABASE_PASSWORD=CHANGE_ME
APP_DATABASE_DBNAME=feed_user
APP_DATABASE_AUTO_MIGRATE=true

# -----------------------------
# Redis
# -----------------------------
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=CHANGE_ME
APP_REDIS_DB=0
APP_REDIS_KEY_PREFIX=feedsystem:v1
# 本地直连留空；集群内填哨兵服务地址（逗号分隔可多个）
# APP_REDIS_SENTINEL_ADDRS=redis.middleware:26379
# APP_REDIS_MASTER_NAME=mymaster

# -----------------------------
# Kafka（本地单节点，逗号分隔多 broker）
# -----------------------------
APP_KAFKA_BROKERS=localhost:9092

# -----------------------------
# MinIO（本地默认 http://localhost:9000）
# -----------------------------
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=phx
APP_MINIO_SECRET_KEY=CHANGE_ME
APP_MINIO_BUCKET=micro-bl
APP_MINIO_USE_SSL=false
APP_MINIO_PUBLIC_READ=true
APP_MINIO_URL_EXPIRY=24h

# -----------------------------
# 可观测性（OTel Collector）
# -----------------------------
APP_OTEL_ENABLED=true
APP_OTEL_ENDPOINT=localhost:4317
APP_OTEL_SAMPLE_RATIO=1.0
APP_OTEL_ENVIRONMENT=local

# -----------------------------
# 运行控制（worker 需 APP_RUN_CRON=true）
# -----------------------------
APP_SKIP_CAPTCHA=false